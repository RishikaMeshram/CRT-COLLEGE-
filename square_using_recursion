class Main {
    static int mul(int x, int y) {
        if (x == 1) {
            return y;
        } 
        else if (y == 1) {
            return x;
        } 
        else if (x == 0 || y == 0) {
            return 0;
        } 
        else {
            return x + mul(x, y - 1);
        }
    }
    public static void main(String[] args) {
        System.out.println(mul(4, 5));
    }
}
